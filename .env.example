# Environment Variables
# Copy this file to .env and add your actual API keys

# Anthropic API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API Base URL
# Keep the default below for Anthropic, or replace it with a compatible endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL
# Keep the default below for OpenAI, or replace it with an OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Gemini API Base URL
# Keep the default below for Gemini, or replace it with a compatible endpoint.
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
